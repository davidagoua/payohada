# ─────────────────────────────────────────────
#  Backend (backend/.env)
# ─────────────────────────────────────────────
DATABASE_URL=
# Configuration Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé de signature HS256 : sa fuite permet de forger un jeton pour n'importe
# quel compte. Générer une valeur aléatoire d'au moins 32 caractères.
SUPABASE_JWT_SECRET=

# Application
DEBUG=false
# Origines autorisées pour les appels navigateur (séparées par des virgules).
CORS_ORIGINS=https://app.exemple.ci
# Facultatif : collecteur d'erreurs (Bugsink / Sentry).
# Laisser vide désactive complètement la remontée d'erreurs.
BUGSINK_DSN=
#: Étiquette jointe aux événements, pour distinguer les environnements.
BUGSINK_ENVIRONMENT=production
#: Échantillonnage des traces de performance.
#: Bugsink ne collecte que les erreurs : il annonce un quota
#: (x-sentry-rate-limits) pour les catégories transaction et span, qu'il
#: écarte. Laisser 0 sauf face à un Sentry complet.
BUGSINK_TRACES_SAMPLE_RATE=0

# Anti brute-force sur l'authentification
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# Réinitialisation de mot de passe
# URL publique du frontend, utilisée pour construire le lien envoyé par email.
FRONTEND_BASE_URL=https://app.exemple.ci
# Durée de validité d'un lien (minutes).
PASSWORD_RESET_EXPIRE_MINUTES=30

# Téléversement de pièces jointes
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.doc,.docx,.xls,.xlsx,.txt,.csv

# Envoi d'emails (obligatoire pour l'envoi des bulletins)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_TIMEOUT=20
EMAIL_FROM=
EMAIL_FROM_NAME=

# ─────────────────────────────────────────────
#  Frontend (frontend/.env)
# ─────────────────────────────────────────────
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_PUBLIC_API_BASE=https://api.exemple.ci/api/v1
# Facultatifs : laisser vide désactive la fonctionnalité correspondante.
NUXT_PUBLIC_BUGSINK_DSN=
NUXT_PUBLIC_BUGSINK_ENVIRONMENT=production
NUXT_PUBLIC_N8N_CHAT_WEBHOOK=

REDIS_URL="redis://user@localhost:6379/0"
